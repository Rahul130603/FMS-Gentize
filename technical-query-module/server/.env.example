# Copy to .env and adjust for your environment.
# When integrating into the existing FMS, reuse the FMS's own DATABASE_URL
# and JWT_SECRET so both apps share the same users/session.

PORT=4000
NODE_ENV=development

# PostgreSQL connection
DATABASE_URL=postgresql://tqms_user:tqms_pass@localhost:5432/tqms_test
PGSSL=false

# JWT verification (only used if this module's standalone auth middleware
# is active — skip if the host FMS already attaches req.user upstream)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# File uploads
UPLOAD_DIR=./src/uploads/technical-queries
MAX_UPLOAD_MB=15

# CORS (comma separated origins allowed to call this API)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
